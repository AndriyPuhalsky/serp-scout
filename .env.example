# Скопіюй у .env і заповни. .env не потрапляє в git; у GitHub Actions ті самі назви — у Secrets.
SERPAPI_KEY=            # serpapi.com → API key (Free: без картки)
ANTHROPIC_API_KEY=      # console.anthropic.com → API keys
LLM_BUDGET_USD=3        # стоп-ліміт витрат LLM на один прогін
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # chat_id з getUpdates після /start боту
TG_DEV=1                # 0 — вимкнути Telegram-сповіщення харнесу (Stop/Notification-хуки)
